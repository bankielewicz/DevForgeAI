import re,os
root=os.getcwd()
files=['SKILL.md']+[os.path.join('references',f) for f in sorted(os.listdir('references')) if f.endswith('.md')]
files+= [os.path.join('assets',f) for f in sorted(os.listdir('assets')) if f.endswith('.md')]
pat=re.compile(r'\]\(([^)]+)\)')
bad=0;tot=0
for f in files:
    txt=open(f,encoding='utf-8').read()
    txt=re.sub(r'```.*?```','',txt,flags=re.S)
    base= root if f=='SKILL.md' else os.path.dirname(os.path.join(root,f))
    for m in pat.finditer(txt):
        d=m.group(1).split(' ')[0].strip('<>')
        if d.startswith(('http://','https://','#','mailto:')) or not d: continue
        tot+=1
        target=d.split('#')[0]
        p=os.path.normpath(os.path.join(base,target))
        inside=os.path.commonpath([p,root])==root
        ok=os.path.exists(p)
        if not(ok and inside):
            bad+=1; print('BROKEN/ESCAPE:',f,'->',d,'| exists',ok,'| inside',inside)
print('local link destinations checked:',tot,'| problems:',bad)
EOF
[exit 0]
