{
  "schema_version": "devforge.skill-validation-plan/v1",
  "run_id": "{{run-id}}",
  "provider": "codex",
  "candidate_root": "{{absolute-source-skill-path}}",
  "input_refs": [
    {
      "kind": "specification",
      "path": "{{absolute-path}}",
      "sha256": "{{sha256}}"
    },
    {
      "kind": "rubric",
      "path": "{{absolute-path}}",
      "sha256": "{{sha256}}"
    },
    {
      "kind": "cases",
      "path": "{{absolute-path}}",
      "sha256": "{{sha256}}"
    },
    {
      "kind": "framework_contract",
      "path": "{{absolute-path}}",
      "sha256": "{{sha256}}"
    }
  ],
  "baseline": {
    "kind": "{{old_skill-or-without_skill}}",
