{
  "type": "object",
  "required": [
    "schema_version",
    "target_name",
    "source_refs",
    "behaviors",
    "resources",
    "adverse_conditions",
    "execution_limits",
    "open_questions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "authoring-design-v1"
    },
    "target_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "(?s).*\\S.*"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?s).*\\S.*"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 0
    },
    "behaviors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "requirement_ids",
          "trigger",
          "inputs",
          "completion",
          "outputs",
          "resource_paths",
          "prerequisites",
          "effects",
          "failure",
          "recovery"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?s).*\\S.*"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "(?s).*\\S.*"
            },
            "minItems": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?s).*\\S.*"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "(?s).*\\S.*"
            },
            "minItems": 0
          },
          "completion": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?s).*\\S.*"
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "(?s).*\\S.*"
            },
            "minItems": 0
          },
          "resource_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "(?s).*\\S.*"
            },
            "minItems": 0
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "(?s).*\\S.*"
            },
            "minItems": 0
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "(?s).*\\S.*"
            },
            "minItems": 0
          },
          "failure": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?s).*\\S.*"
          },
          "recovery": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?s).*\\S.*"
          }
        }
      },
      "minItems": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "purpose",
          "load_when",
          "helper_contract"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?s).*\\S.*"
          },
          "kind": {
            "enum": [
              "instruction",
              "reference",
              "template",
              "helper"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?s).*\\S.*"
          },
          "load_when": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?s).*\\S.*"
          },
          "helper_contract": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "inputs",
                  "outputs",
                  "runtime",
                  "effects",
                  "errors",
                  "reuse_reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "inputs": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "(?s).*\\S.*"
                  },
                  "outputs": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "(?s).*\\S.*"
                  },
                  "runtime": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "(?s).*\\S.*"
                  },
                  "effects": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "(?s).*\\S.*"
                  },
                  "errors": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "(?s).*\\S.*"
                  },
                  "reuse_reason": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "(?s).*\\S.*"
                  }
                }
              }
            ]
          }
        }
      },
      "minItems": 0
    },
    "adverse_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "behavior_id",
          "condition",
          "expected_observation",
          "requirement_basis"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?s).*\\S.*"
          },
          "behavior_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?s).*\\S.*"
          },
          "condition": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?s).*\\S.*"
          },
          "expected_observation": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?s).*\\S.*"
          },
          "requirement_basis": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?s).*\\S.*"
          }
        }
      },
      "minItems": 0
    },
    "execution_limits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "behavior_id",
          "seconds",
          "kind",
          "source_basis"
        ],
        "additionalProperties": false,
        "properties": {
          "behavior_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?s).*\\S.*"
          },
          "seconds": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "specified_requirement",
              "execution_ceiling"
            ]
          },
          "source_basis": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?s).*\\S.*"
          }
        }
      },
      "minItems": 0
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "owner",
          "affected_behavior_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?s).*\\S.*"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?s).*\\S.*"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?s).*\\S.*"
          },
          "affected_behavior_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "(?s).*\\S.*"
            },
            "minItems": 1
          }
        }
      },
      "minItems": 0
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
