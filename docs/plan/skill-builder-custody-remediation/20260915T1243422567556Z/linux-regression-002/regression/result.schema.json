{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["case", "status", "seconds", "detail"],
  "properties": {
    "case": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FAIL", "ERROR", "SKIP"]},
    "seconds": {"type": "number", "minimum": 0},
    "detail": {"type": "string"}
  }
}
