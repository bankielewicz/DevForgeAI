{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "role",
    "binding_required",
    "parent_core",
    "contract_path",
    "required_capabilities",
    "resource_roles"
  ],
  "properties": {
    "schema_version": {
      "const": "adaptive-skill-v1"
    },
    "name": {
      "$ref": "adaptive-common.schema.json#/$defs/Name"
    },
    "role": {
      "enum": [
        "core",
        "project_variant",
        "expertise"
      ]
    },
    "binding_required": {
      "const": true
    },
    "parent_core": {
      "anyOf": [
        {
          "$ref": "adaptive-common.schema.json#/$defs/CoreLineage"
        },
        {
          "type": "null"
        }
      ]
    },
    "contract_path": {
      "const": "references/adaptive-contract.md"
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resource_roles": {
      "type": "array",
      "items": {
        "$ref": "adaptive-common.schema.json#/$defs/ResourceRole"
      }
    }
  }
}
