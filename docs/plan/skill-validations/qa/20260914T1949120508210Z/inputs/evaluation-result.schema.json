{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "kind",
    "required",
    "result",
    "expected",
    "observed",
    "reason",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "qa-eval-result-v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "grader-control",
        "skill-scenario"
      ]
    },
    "required": {
      "type": "boolean"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN",
        "ERROR"
      ]
    },
    "expected": {},
    "observed": {},
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
