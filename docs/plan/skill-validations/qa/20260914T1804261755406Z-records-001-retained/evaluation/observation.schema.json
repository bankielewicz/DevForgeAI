{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "result", "reason", "method", "evidence"],
  "properties": {
    "case_id": {"type":"string", "pattern":"^QV-(0[1-9]|1[0-9]|2[01])$"},
    "result": {"enum":["PASS","FAIL","NOT_RUN","ERROR"]},
    "reason": {"type":"string", "minLength":1},
    "method": {"enum":["deterministic","semantic","behavioral"]},
    "evidence": {"type":"array", "items":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}
  }
}
