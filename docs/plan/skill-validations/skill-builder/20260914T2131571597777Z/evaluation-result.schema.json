{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "case_id",
    "result",
    "detail"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "ERROR",
        "NOT_RUN"
      ]
    },
    "detail": {
      "type": "string"
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
