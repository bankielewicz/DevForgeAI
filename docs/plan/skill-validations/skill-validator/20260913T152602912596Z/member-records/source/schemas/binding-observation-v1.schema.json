{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "reason_code",
    "binding_sha256",
    "package_digest",
    "details"
  ],
  "properties": {
    "schema_version": {
      "const": "binding-observation-v1"
    },
    "status": {
      "enum": [
        "MATCH",
        "MISMATCH",
        "UNAVAILABLE"
      ]
    },
    "reason_code": {
      "$ref": "adaptive-common.schema.json#/$defs/Id"
    },
    "binding_sha256": {
      "anyOf": [
        {
          "$ref": "adaptive-common.schema.json#/$defs/Digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "package_digest": {
      "anyOf": [
        {
          "$ref": "adaptive-common.schema.json#/$defs/Digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "details": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
