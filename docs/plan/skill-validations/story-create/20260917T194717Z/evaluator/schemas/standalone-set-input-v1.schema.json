{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "authorization",
    "members",
    "handoffs",
    "requirements",
    "gaps"
  ],
  "properties": {
    "schema_version": {
      "const": "standalone-set-input-v1"
    },
    "run_id": {
      "$ref": "adaptive-common.schema.json#/$defs/Id"
    },
    "authorization": {
      "$ref": "adaptive-common.schema.json#/$defs/Ref"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "member_id",
          "package",
          "specifications",
          "adaptive_descriptor",
          "depends_on"
        ],
        "properties": {
          "member_id": {
            "$ref": "adaptive-common.schema.json#/$defs/Id"
          },
          "package": {
            "$ref": "adaptive-common.schema.json#/$defs/PackageRef"
          },
          "specifications": {
            "type": "array",
            "items": {
              "$ref": "adaptive-common.schema.json#/$defs/Ref"
            },
            "minItems": 0
          },
          "adaptive_descriptor": {
            "anyOf": [
              {
                "$ref": "adaptive-common.schema.json#/$defs/Ref"
              },
              {
                "type": "null"
              }
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "$ref": "adaptive-common.schema.json#/$defs/Id"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        }
      },
      "minItems": 1
    },
    "handoffs": {
      "type": "array",
      "items": {
        "$ref": "adaptive-common.schema.json#/$defs/Handoff"
      },
      "minItems": 0
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "adaptive-common.schema.json#/$defs/Requirement"
      },
      "minItems": 0
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "adaptive-common.schema.json#/$defs/Gap"
      },
      "minItems": 0
    }
  }
}
