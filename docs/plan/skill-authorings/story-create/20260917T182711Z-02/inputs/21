# Contract: Template-Consumer Schema Authority
# Version: 1.0.0
# Created: 2026-03-25
# Purpose: Enforce that phase files derive structural constants from the story
#          template's SECTION_MANIFEST rather than hardcoding shadow copies.
# Related: RCA-048 (Story Template Not Authoritative Driver)
# Type: schema-authority (template defines truth; phases consume it)

contract_version: "1.0.0"
contract_type: "schema-authority"
skill: spec-driven-stories

# The authoritative source of truth for story structure
# authority source: story-template.md (schema-authority pattern)
authority:
  file: "assets/templates/story-template.md"
  manifest_block: "SECTION_MANIFEST"
  manifest_format: "YAML inside HTML comment (<!-- SECTION_MANIFEST ... END_SECTION_MANIFEST -->)"
  manifest_field_dependencies:
    - name: "name"
      description: "Section display name (e.g., 'Description', 'Acceptance Criteria')"
    - name: "header_level"
      description: "Markdown header depth (2 = H2, 3 = H3)"
    - name: "status"
      description: "Requirement level for the section"
      valid_values: ["Required", "Optional", "Conditional"]
    - name: "line_range"
      description: "Informational only - approximate line range in template (not used for enforcement)"

# === Consumer Rules ===
# Each rule defines a MUST/FORBIDDEN contract between the template (authority)
# and the phase files (consumers). Phase files MUST derive values from the
# template at runtime; they MUST NOT hardcode shadow copies.

consumer_rules:
  TCR-001:
    name: "version_extraction"
    consumer_phase: "Phase 05"
    consumer_step: "Step 5.3"
    consumer_file: "src/claude/skills/spec-driven-stories/phases/phase-05-story-file-creation.md"
    requirement: "MUST extract template_version from loaded template YAML frontmatter"
    forbidden: "Hardcoding version strings is FORBIDDEN"
    compliant_example: |
      # Load the template file, parse YAML frontmatter, extract template_version
      template_content = load_file("assets/templates/story-template.md")
      template_version = parse_frontmatter(template_content).template_version
      # Use extracted value in story frontmatter
      story.frontmatter.template_version = template_version
    non_compliant_example: |
      # Hardcoded version string - VIOLATION
      story.frontmatter.template_version = "3.0"

  TCR-002:
    name: "section_list_derivation"
    consumer_phase: "Phase 05"
    consumer_step: "Step 5.5"
    consumer_file: "src/claude/skills/spec-driven-stories/phases/phase-05-story-file-creation.md"
    requirement: "MUST parse SECTION_MANIFEST to derive required_h2_headers (filter: header_level=2, status=Required), conditional_h2_headers (filter: header_level=2, status=Conditional), and required_h3_subsections (filter: header_level=3, status=Required)"
    forbidden: "Hardcoding section arrays is FORBIDDEN"
    compliant_example: |
      # Parse SECTION_MANIFEST from template
      manifest = parse_section_manifest(template_content)
      required_h2 = [s.name for s in manifest if s.header_level == 2 and s.status == "Required"]
      conditional_h2 = [s.name for s in manifest if s.header_level == 2 and s.status == "Conditional"]
      required_h3 = [s.name for s in manifest if s.header_level == 3 and s.status == "Required"]
    non_compliant_example: |
      # Hardcoded section list - VIOLATION
      required_h2 = ["Description", "Acceptance Criteria", "Technical Specification"]

  TCR-003:
    name: "validation_version"
    consumer_phase: "Phase 07"
    consumer_step: "Step 7.1"
    consumer_file: "src/claude/skills/spec-driven-stories/phases/phase-07-self-validation.md"
    requirement: "MUST read the template and extract template_version for comparison during frontmatter validation"
    forbidden: "Hardcoding expected version strings is FORBIDDEN"
    compliant_example: |
      # Load template to get current version for validation
      template_content = load_file("assets/templates/story-template.md")
      expected_version = parse_frontmatter(template_content).template_version
      # Compare against generated story's frontmatter
      if story.template_version != expected_version:
          report_validation_error("template_version mismatch")
    non_compliant_example: |
      # Hardcoded expected version - VIOLATION
      if story.template_version != "3.0":
          report_validation_error("template_version mismatch")

  TCR-004:
    name: "subsection_generation"
    consumer_phase: "Phase 03"
    consumer_step: "Step 3.6"
    consumer_file: "src/claude/skills/spec-driven-stories/phases/phase-03-technical-specification.md"
    requirement: "MUST reference the template's SECTION_MANIFEST (filter: parent section = Implementation Guide, header_level=3) to determine subsections to generate"
    forbidden: "Hardcoding subsection name lists is FORBIDDEN"
    compliant_example: |
      # Parse SECTION_MANIFEST for Implementation Guide subsections
      manifest = parse_section_manifest(template_content)
      impl_subsections = [s.name for s in manifest
                          if s.header_level == 3 and s.parent == "Implementation Guide"]
      # Generate each subsection dynamically
      for subsection in impl_subsections:
          generate_subsection(subsection)
    non_compliant_example: |
      # Hardcoded subsection list - VIOLATION
      subsections = ["Architecture Decisions", "Implementation Sequence",
                     "Cross-Cutting Concerns", "Key Algorithms"]

# === Violations ===
# Each violation type maps to one or more of the 7 drift points identified
# in RCA-048. Regex patterns enable grep-based automated detection.

violations:
  hardcoded_version:
    severity: "CRITICAL"
    enforcement: "blocking"
    description: "Detects hardcoded template_version strings in phase files. These shadow copies drift when the template version is bumped, causing generated stories to carry stale version metadata."
    pattern: 'template_version:\s*["\x27]?\d+\.\d+["\x27]?'
    example_locations:
      - file: "src/claude/skills/spec-driven-stories/phases/phase-05-story-file-creation.md"
        location: "line 114"
        context: "version stamp in frontmatter generation"
      - file: "src/claude/skills/spec-driven-stories/phases/phase-05-story-file-creation.md"
        location: "line 85"
        context: "version display in story metadata"
      - file: "src/claude/skills/spec-driven-stories/phases/phase-07-self-validation.md"
        location: "line 73"
        context: "version validation comparison"

  hardcoded_section_array:
    severity: "HIGH"
    enforcement: "blocking"
    description: "Detects hardcoded arrays of section names or header lists in phase files. These shadow copies drift when the template adds, removes, or renames sections."
    pattern: '(required_h2_headers|required_sections|section_list)\s*[:=]\s*\['
    example_locations:
      - file: "src/claude/skills/spec-driven-stories/phases/phase-05-story-file-creation.md"
        line_range: "194-207"
        context: "H2 required headers list"
      - file: "src/claude/skills/spec-driven-stories/phases/phase-05-story-file-creation.md"
        line_range: "210-227"
        context: "H3 required subsections list"

  hardcoded_subsection_list:
    severity: "HIGH"
    enforcement: "blocking"
    description: "Detects hardcoded lists of subsection names for Implementation Guide or other parent sections. These shadow copies drift when the template modifies subsection structure."
    pattern: '(subsection_names|subsections|impl_subsections)\s*[:=]\s*\['
    example_locations:
      - file: "src/claude/skills/spec-driven-stories/phases/phase-03-technical-specification.md"
        line_range: "218-222"
        context: "Implementation Guide subsection names"
      - file: "src/claude/skills/spec-driven-stories/phases/phase-05-story-file-creation.md"
        line_range: "234-239"
        context: "Implementation Guide subsection generation list"

# === Verification ===
# Self-test procedure to verify that the contract's rules are being honored.
# This test proves that phase files derive values from the template rather
# than hardcoding them.

verification:
  self_test:
    description: "End-to-end verification that template changes propagate to generated stories without manual phase file edits"
    steps:
      - step_1:
          action: "Bump template_version to a test value (e.g., \"3.1\") in story-template.md"
          target: "assets/templates/story-template.md"
          field: "template_version"
          test_value: "3.1"
      - step_2:
          action: "Execute the /create-story workflow with any valid feature description"
          command: "/create-story"
      - step_3:
          action: "Verify the generated story frontmatter contains template_version: \"3.1\" without any manual edits to phase files"
          check: "grep 'template_version' generated_story.md"
      - step_4:
          action: "Verify that all phase files automatically use the bumped version"
      - step_5:
          action: "Restore template_version to its original value after testing"
          cleanup: true
    expected_outcome: "all phase files automatically use the bumped version"
    failure_indicator: "phase file still outputs the old version value"

  negative_test:
    description: "Verify that a non-compliant phase file (one that hardcodes version) does NOT propagate the bumped version"
    steps:
      - step_1:
          action: "Temporarily hardcode template_version: \"2.8\" in a phase file"
      - step_2:
          action: "Bump story-template.md template_version to \"3.1\""
      - step_3:
          action: "Run /create-story and check the generated story"
    expected_outcome: "generated story shows hardcoded \"2.8\" instead of bumped \"3.1\", proving non-compliance"
    failure_indicator: "generated story correctly shows \"3.1\" despite hardcoded value (would mean the hardcoded path is not executed)"

# === Enforcement Status ===
# This contract defines rules but does not enforce them at runtime.
# Enforcement is implemented by subsequent stories:
#   - REC-2 (Phase 05 retrofit) implements TCR-001 and TCR-002
#   - REC-3 (Phase 07 retrofit) implements TCR-003
#   - REC-4 (Phase 03 retrofit) implements TCR-004
enforcement_status: "defined_not_enforced"

