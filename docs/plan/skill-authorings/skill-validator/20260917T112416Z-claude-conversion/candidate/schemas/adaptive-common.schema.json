{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "Name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "Id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "RelPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*[\\\\:\u0000])(?!(?:.*/)?[.]{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "Ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "Locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "start_line",
        "end_line"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/Ref"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origin",
        "statement",
        "source_refs",
        "rationale",
        "verification"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "origin": {
          "enum": [
            "user",
            "source",
            "derived"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Locator"
          }
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "verification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "required",
        "observed",
        "evidence",
        "limitation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "observed": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "limitation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "member_id",
        "requirement_ids",
        "description",
        "resolution",
        "evidence"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/Id"
        },
        "member_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ref"
          }
        }
      }
    },
    "Fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "statement",
        "basis",
        "sources"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "category": {
          "enum": [
            "architecture",
            "domain",
            "language",
            "toolchain",
            "development_style",
            "requirements",
            "existing_skills",
            "constraint"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "enum": [
            "observed",
            "user_supplied",
            "unknown"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Locator"
          }
        }
      }
    },
    "Exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "reason",
        "material"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "material": {
          "type": "boolean"
        }
      }
    },
    "PackageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "root",
        "manifest",
        "package_digest"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/Name"
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "$ref": "#/$defs/Ref"
        },
        "package_digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "LineageRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "disposition",
        "reason",
        "replacement_requirement_ids"
      ],
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/Id"
        },
        "disposition": {
          "enum": [
            "retained",
            "modified",
            "removed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "replacement_requirement_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "uniqueItems": true
        }
      }
    },
    "Handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "producer",
        "consumer",
        "artifact_role",
        "format",
        "schema_ref",
        "contract",
        "required",
        "failure_behavior"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "producer": {
          "$ref": "#/$defs/Id"
        },
        "consumer": {
          "$ref": "#/$defs/Id"
        },
        "artifact_role": {
          "$ref": "#/$defs/Id"
        },
        "format": {
          "enum": [
            "json",
            "text",
            "file_set"
          ]
        },
        "schema_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "contract": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "failure_behavior": {
          "enum": [
            "block_consumer",
            "report_optional_absence"
          ]
        }
      }
    },
    "Member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role",
        "action",
        "target_root",
        "existing_package",
        "parent_core",
        "responsibility",
        "exclusions",
        "triggers",
        "near_misses",
        "requirement_ids",
        "fact_ids",
        "rationale",
        "depends_on",
        "capabilities",
        "lineage_delta"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "role": {
          "enum": [
            "core",
            "project_variant",
            "expertise"
          ]
        },
        "action": {
          "enum": [
            "retain",
            "create",
            "revise"
          ]
        },
        "target_root": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "existing_package": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_core": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "responsibility": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "near_misses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "uniqueItems": true
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "lineage_delta": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LineageRow"
          }
        }
      }
    },
    "Destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_id",
        "target_root"
      ],
      "properties": {
        "member_id": {
          "$ref": "#/$defs/Id"
        },
        "target_root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "MemberResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_id",
        "status",
        "authoring_record",
        "validation_request",
        "package",
        "reason",
        "applied_paths"
      ],
      "properties": {
        "member_id": {
          "$ref": "#/$defs/Id"
        },
        "status": {
          "enum": [
            "AUTHORED",
            "RETAINED",
            "PARTIAL",
            "BLOCKED",
            "DEPENDENCY_BLOCKED"
          ]
        },
        "authoring_record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_request": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "package": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "applied_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RelPath"
          },
          "uniqueItems": true
        }
      }
    },
    "AssessmentMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_id",
        "package",
        "request",
        "adaptive_descriptor"
      ],
      "properties": {
        "member_id": {
          "$ref": "#/$defs/Id"
        },
        "package": {
          "$ref": "#/$defs/PackageRef"
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "adaptive_descriptor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CoreLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "package_digest",
        "requirement_ids"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/Name"
        },
        "package_digest": {
          "$ref": "#/$defs/Digest"
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "ResourceRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "reason"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/RelPath"
        },
        "role": {
          "enum": [
            "runtime",
            "template",
            "reference",
            "fixture",
            "license"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "InstalledBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "package_path",
        "package_digest",
        "role",
        "selected"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/Name"
        },
        "package_path": {
          "$ref": "#/$defs/RelPath"
        },
        "package_digest": {
          "$ref": "#/$defs/Digest"
        },
        "role": {
          "enum": [
            "core",
            "project_variant",
            "expertise"
          ]
        },
        "selected": {
          "type": "boolean"
        }
      }
    },
    "ManifestRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/RelPath"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        }
      }
    }
  }
}
