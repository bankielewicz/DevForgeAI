{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "errors",
    "ordered_member_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "adaptive-observation-v1"
    },
    "status": {
      "enum": [
        "VALID",
        "INVALID",
        "UNAVAILABLE"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ordered_member_ids": {
      "type": "array",
      "items": {
        "$ref": "adaptive-common.schema.json#/$defs/Id"
      },
      "uniqueItems": true
    }
  }
}
