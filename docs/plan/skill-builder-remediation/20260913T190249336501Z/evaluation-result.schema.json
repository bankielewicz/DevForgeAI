{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "status", "detail", "package_digest", "method", "attempt"],
  "properties": {
    "schema_version": {"const": "maintenance-case-v1"},
    "case_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FAIL", "ERROR", "NOT_RUN"]},
    "detail": {"type": ["string", "null"]},
    "package_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "method": {"const": "Python implementation regression"},
    "attempt": {"type": "string", "minLength": 1}
  }
}
