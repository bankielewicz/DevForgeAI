{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["count", "total"],
  "additionalProperties": false,
  "properties": {
    "count": {"type": "integer", "minimum": 0},
    "total": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}(?![\\s\\S])"}
  }
}
