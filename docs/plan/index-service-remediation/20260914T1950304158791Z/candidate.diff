+//! Contract-derived boundary and recovery checks for previously unexecuted paths.
+use devforgeai_index::{
+    index, platform,
+    protocol::{ErrorCode, ProjectConfig},
+    storage::{Store, StoredFile},
+};
+use serde_json::json;
+use std::{
+    fs,
+    sync::{Arc, atomic::AtomicBool},
