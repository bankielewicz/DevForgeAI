+    #[cfg(windows)]
+    {
+        let outside = tempfile::tempdir().unwrap();
+        let file = outside.path().join("other.txt");
+        fs::write(&file, b"outside").unwrap();
+        assert!(
+            matches!(open_leaf(&canonical, &file), Err(error) if error == "path_outside_project")
+        );
+    }
+}
