{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devforgeai:index:request:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "request_id", "operation", "timeout_ms", "params"],
  "properties": {
    "protocol_version": {"const": 1},
    "request_id": {"$ref": "#/$defs/uuid"},
    "operation": {"type": "string"},
    "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 120000},
    "params": {"type": "object"}
  },
  "oneOf": [
    {"properties": {"operation": {"enum": ["daemon.handshake", "daemon.status", "daemon.pause", "daemon.resume", "daemon.stop", "daemon.diagnostics", "project.list"]}, "params": {"type": "object", "additionalProperties": false}}},
    {"properties": {"operation": {"enum": ["project.remove", "index.status", "index.rescan", "index.reindex", "index.reconcile"]}, "params": {"$ref": "#/$defs/project"}}},
    {"properties": {"operation": {"enum": ["job.status", "job.cancel"]}, "params": {"type": "object", "additionalProperties": false, "required": ["job_id"], "properties": {"job_id": {"$ref": "#/$defs/uuid"}}}}},
    {"properties": {"operation": {"const": "project.add"}, "params": {"type": "object", "additionalProperties": false, "required": ["root", "name"], "properties": {"root": {"type": "string", "minLength": 1}, "name": {"type": "string", "pattern": "\\S"}}}}},
    {"properties": {"operation": {"const": "project.update"}, "params": {"type": "object", "additionalProperties": false, "required": ["project_id", "config"], "properties": {"project_id": {"$ref": "#/$defs/uuid"}, "config": {"$ref": "#/$defs/config"}}}}},
    {"properties": {"operation": {"const": "index.rebuild"}, "params": {"type": "object", "additionalProperties": false, "required": ["project_id", "affected_projects"], "properties": {"project_id": {"$ref": "#/$defs/uuid"}, "affected_projects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/uuid"}}}}}}
  ],
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "project": {"type": "object", "additionalProperties": false, "required": ["project_id"], "properties": {"project_id": {"$ref": "#/$defs/uuid"}}},
    "config": {"type": "object", "additionalProperties": false, "properties": {
      "exclusions": {"type": ["array", "null"], "items": {"type": "string"}},
      "text_extensions": {"type": ["array", "null"], "items": {"type": "string"}},
      "text_names": {"type": ["array", "null"], "items": {"type": "string"}},
      "default_exclusions": {"type": ["boolean", "null"]},
      "max_file_bytes": {"type": ["integer", "null"], "minimum": 1024, "maximum": 52428800}
    }}
  }
}
