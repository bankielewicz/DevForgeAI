+        "enterpriseManaged",
+        "legacyManagedConfigTomlFromMdm",
+        "futureUnknownSource",
+    ] {
+        let mut case = valid.clone();
+        case["layers"][0]["name"] = json!({"type":source_type});
+        assert_error(
+            effective_profile::validate_config(&case, &cwd, &covered),
+            "profile_unqualified",
+        );
