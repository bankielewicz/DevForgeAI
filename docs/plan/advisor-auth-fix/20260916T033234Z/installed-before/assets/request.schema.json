{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Advisor request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ask", "repo_root", "claude_path", "contract_path", "contract_sha256"],
  "properties": {
    "schema": {"const": "advisor-request-v1"},
    "ask": {"type": "string", "pattern": "\\S"},
    "type": {"enum": ["approach", "stuck", "done", "reconcile"], "default": "approach"},
    "model": {"enum": ["opus", "sonnet"], "default": "opus"},
    "effort": {"enum": ["high", "max"], "default": "high"},
    "repo_root": {"type": "string", "minLength": 1, "description": "Existing absolute directory; runner checks path semantics"},
    "claude_path": {"type": "string", "minLength": 1, "description": "Existing absolute native executable path"},
    "contract_path": {"type": "string", "minLength": 1, "description": "Existing absolute contract file"},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "total_budget_usd": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$", "default": "2.00", "description": "0.02 through 100.00, additionally checked by runner"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 1800, "default": 300}
  }
}
