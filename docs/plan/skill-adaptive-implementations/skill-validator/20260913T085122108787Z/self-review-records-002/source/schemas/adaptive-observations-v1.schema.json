{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "target_digest",
    "unicode_candidates",
    "resources",
    "edges",
    "context",
    "bindings",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "adaptive-observations-v1"
    },
    "run_id": {
      "$ref": "adaptive-common.schema.json#/$defs/Id"
    },
    "target_digest": {
      "$ref": "adaptive-common.schema.json#/$defs/Digest"
    },
    "unicode_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "start_byte",
          "end_byte",
          "line",
          "column",
          "codepoint",
          "unicode_name",
          "escaped_excerpt",
          "context",
          "disposition",
          "reason"
        ],
        "properties": {
          "path": {
            "$ref": "adaptive-common.schema.json#/$defs/RelPath"
          },
          "start_byte": {
            "type": "integer",
            "minimum": 0
          },
          "end_byte": {
            "type": "integer",
            "minimum": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "codepoint": {
            "type": "string",
            "minLength": 1
          },
          "unicode_name": {
            "type": "string",
            "minLength": 1
          },
          "escaped_excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "context": {
            "enum": [
              "prose",
              "metadata",
              "command",
              "path",
              "fixture",
              "unknown"
            ]
          },
          "disposition": {
            "enum": [
              "defect",
              "legitimate",
              "unresolved"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "reachable",
          "usage",
          "evidence",
          "reason"
        ],
        "properties": {
          "path": {
            "$ref": "adaptive-common.schema.json#/$defs/RelPath"
          },
          "role": {
            "enum": [
              "runtime",
              "template",
              "reference",
              "fixture",
              "license",
              "unknown"
            ]
          },
          "reachable": {
            "type": "boolean"
          },
          "usage": {
            "enum": [
              "used",
              "intentional_nonruntime",
              "orphan",
              "unresolved_usage"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "adaptive-common.schema.json#/$defs/Ref"
            },
            "minItems": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "line",
          "target",
          "kind",
          "resolution"
        ],
        "properties": {
          "source": {
            "$ref": "adaptive-common.schema.json#/$defs/RelPath"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "link",
              "image",
              "instruction",
              "script_call",
              "template_use"
            ]
          },
          "resolution": {
            "enum": [
              "resolved",
              "missing",
              "outside_scope",
              "dynamic",
              "unsupported_anchor"
            ]
          }
        }
      },
      "minItems": 0
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenizer",
        "files",
        "loads",
        "budget",
        "budget_result",
        "reason"
      ],
      "properties": {
        "tokenizer": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "version",
                "encoding"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "encoding": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "bytes",
              "characters",
              "lines",
              "tokens"
            ],
            "properties": {
              "path": {
                "$ref": "adaptive-common.schema.json#/$defs/RelPath"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "characters": {
                "type": "integer",
                "minimum": 0
              },
              "lines": {
                "type": "integer",
                "minimum": 0
              },
              "tokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "minItems": 0
        },
        "loads": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "path",
              "occurrences",
              "basis",
              "tokens",
              "evidence"
            ],
            "properties": {
              "case_id": {
                "$ref": "adaptive-common.schema.json#/$defs/Id"
              },
              "path": {
                "$ref": "adaptive-common.schema.json#/$defs/RelPath"
              },
              "occurrences": {
                "type": "integer",
                "minimum": 1
              },
              "basis": {
                "enum": [
                  "observed_full_file",
                  "observed_excerpt",
                  "static_estimate"
                ]
              },
              "tokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "adaptive-common.schema.json#/$defs/Ref"
                },
                "minItems": 0
              }
            }
          },
          "minItems": 0
        },
        "budget": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "scope",
                "maximum",
                "case_id",
                "source"
              ],
              "properties": {
                "unit": {
                  "enum": [
                    "bytes",
                    "characters",
                    "tokens"
                  ]
                },
                "scope": {
                  "enum": [
                    "entrypoint",
                    "unique_branch_content",
                    "observed_total_loads"
                  ]
                },
                "maximum": {
                  "type": "integer",
                  "minimum": 1
                },
                "case_id": {
                  "anyOf": [
                    {
                      "$ref": "adaptive-common.schema.json#/$defs/Id"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source": {
                  "$ref": "adaptive-common.schema.json#/$defs/Ref"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "budget_result": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN",
            "NOT_APPLICABLE"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "binding_sha256",
          "observation",
          "expected",
          "observed",
          "effects_match"
        ],
        "properties": {
          "case_id": {
            "$ref": "adaptive-common.schema.json#/$defs/Id"
          },
          "binding_sha256": {
            "anyOf": [
              {
                "$ref": "adaptive-common.schema.json#/$defs/Digest"
              },
              {
                "type": "null"
              }
            ]
          },
          "observation": {
            "$ref": "adaptive-common.schema.json#/$defs/Ref"
          },
          "expected": {
            "enum": [
              "MATCH",
              "MISMATCH",
              "UNAVAILABLE"
            ]
          },
          "observed": {
            "enum": [
              "MATCH",
              "MISMATCH",
              "UNAVAILABLE",
              "NOT_RUN"
            ]
          },
          "effects_match": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  }
}
