{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deterministic observation; no acceptance authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "profile",
    "profile_version",
    "python_version",
    "platform",
    "case_id",
    "grader_id",
    "grader_version",
    "grader_sha256",
    "build_manifest_sha256",
    "cases_sha256",
    "candidate_digests",
    "observations",
    "status",
    "expected",
    "expectation_met",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": "2"
    },
    "run_id": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "profile_version": {
      "type": ["string", "null"]
    },
    "python_version": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "case_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "grader_id": {
      "enum": [
        "package_links",
        "manifest_accounting",
        "build_traceability",
        "revision_consistency",
        "routing_outcomes",
        null
      ]
    },
    "grader_version": {
      "const": "2.0.0"
    },
    "grader_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "build_manifest_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "cases_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate_digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "ERROR"
      ]
    },
    "expected": {
      "enum": [
        "PASS",
        "FAIL",
        null
      ]
    },
    "expectation_met": {
      "type": "boolean"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
