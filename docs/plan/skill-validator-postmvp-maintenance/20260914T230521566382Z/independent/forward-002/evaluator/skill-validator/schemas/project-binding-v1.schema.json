{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "project_root",
    "revision",
    "bindings",
    "updated_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "project-binding-v1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "project_root": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "adaptive-common.schema.json#/$defs/InstalledBinding"
      },
      "minItems": 1
    },
    "updated_at_utc": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?Z$"
    }
  }
}
