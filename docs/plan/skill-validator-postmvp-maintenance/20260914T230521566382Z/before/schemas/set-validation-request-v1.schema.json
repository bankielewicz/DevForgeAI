{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "selection",
    "set_authoring",
    "scope",
    "members",
    "handoffs",
    "omitted_member_ids",
    "omitted_handoff_ids",
    "permission"
  ],
  "properties": {
    "schema_version": {
      "const": "set-validation-request-v1"
    },
    "run_id": {
      "$ref": "adaptive-common.schema.json#/$defs/Id"
    },
    "selection": {
      "$ref": "adaptive-common.schema.json#/$defs/Ref"
    },
    "set_authoring": {
      "$ref": "adaptive-common.schema.json#/$defs/Ref"
    },
    "scope": {
      "enum": [
        "full_set",
        "eligible_subset"
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "adaptive-common.schema.json#/$defs/AssessmentMember"
      },
      "minItems": 1
    },
    "handoffs": {
      "type": "array",
      "items": {
        "$ref": "adaptive-common.schema.json#/$defs/Handoff"
      }
    },
    "omitted_member_ids": {
      "type": "array",
      "items": {
        "$ref": "adaptive-common.schema.json#/$defs/Id"
      },
      "uniqueItems": true
    },
    "omitted_handoff_ids": {
      "type": "array",
      "items": {
        "$ref": "adaptive-common.schema.json#/$defs/Id"
      },
      "uniqueItems": true
    },
    "permission": {
      "type": "string",
      "minLength": 1
    }
  }
}
