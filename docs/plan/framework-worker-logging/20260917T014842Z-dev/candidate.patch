+#[test]
+fn policy_targets_real_mcp_keys_under_literal_cli_dotted_key_rules() {
+    let v: Value =
+        serde_json::from_str(devforgeai_codex_worker_probe::launch_policy::RECORD).unwrap();
+    let keys: Vec<_> = v["argv"]
+        .as_array()
+        .unwrap()
+        .iter()
