{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.devforgeai.local/sdd/prd.schema.json",
  "title": "prd document (frontmatter plus item blocks)",
  "type": "object",
  "required": [
    "frontmatter"
  ],
  "properties": {
    "frontmatter": {
      "type": "object",
      "required": [
        "authors",
        "blocked_by",
        "created",
        "id",
        "operating_context",
        "owner",
        "stage",
        "status",
        "superseded_by",
        "supersedes",
        "title",
        "type",
        "updated",
        "upstream",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/docId"
        },
        "type": {
          "const": "prd"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "in-review",
            "approved",
            "superseded",
            "deprecated"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "created": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "updated": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "owner": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generated_by": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tool": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "session": {
              "type": "string"
            }
          }
        },
        "reviewed_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approved_by": {
          "type": "string"
        },
        "approved_on": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "upstream": {
          "$ref": "common.schema.json#/$defs/links"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/docId"
          }
        },
        "superseded_by": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/docId"
            },
            {
              "type": "null"
            }
          ]
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(BRN|PRD|EPIC|SPR|STORY|SPEC|ADR|SKL|POL|TASK|TEST)-\\d{3}(#[A-Z]+-\\d{2,3})?$"
          }
        },
        "target_release": {
          "type": "string"
        },
        "stakeholders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stage": {
          "enum": [
            "prototype",
            "mvp",
            "evolution",
            null
          ],
          "description": "Scope maturity: prototype (exploratory, may be discarded), mvp (smallest scope that delivers value to real users and is built upon), evolution (changes an established product: new capability, maintenance, migration or refactoring). null until the user decides. Controls interview depth."
        },
        "operating_context": {
          "enum": [
            "local",
            "internal",
            "pilot",
            "production",
            null
          ],
          "description": "Who uses it and with what data: local (developers only, synthetic data), internal (own organization, may touch real internal data), pilot (limited real external users or real customer data), production (generally available to real users with real data). null until the user decides. Controls which quality categories must be asked."
        }
      },
      "additionalProperties": false
    },
    "success_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "metric",
          "status",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SM-\\d{2}$"
          },
          "status": {
            "enum": [
              "active",
              "deprecated"
            ]
          },
          "superseded_by": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/itemId"
              },
              {
                "type": "null"
              }
            ]
          },
          "upstream": {
            "$ref": "common.schema.json#/$defs/links"
          },
          "metric": {
            "type": "string"
          },
          "baseline": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "measured_by": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "functional_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "priority",
          "release",
          "statement",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FR-\\d{3}$"
          },
          "status": {
            "enum": [
              "active",
              "deprecated"
            ]
          },
          "superseded_by": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/itemId"
              },
              {
                "type": "null"
              }
            ]
          },
          "upstream": {
            "$ref": "common.schema.json#/$defs/links"
          },
          "statement": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "must",
              "should",
              "could",
              "wont",
              null
            ],
            "description": "MoSCoW importance within its release. null until the user decides."
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "release": {
            "enum": [
              "current",
              "later",
              null
            ],
            "description": "Which release the item belongs to: current = this PRD's target_release, later = backlog. null until the user decides."
          }
        },
        "additionalProperties": false
      }
    },
    "non_functional_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "id",
          "priority",
          "release",
          "statement",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^NFR-\\d{3}$"
          },
          "status": {
            "enum": [
              "active",
              "deprecated"
            ]
          },
          "superseded_by": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/itemId"
              },
              {
                "type": "null"
              }
            ]
          },
          "upstream": {
            "$ref": "common.schema.json#/$defs/links"
          },
          "category": {
            "enum": [
              "performance",
              "security",
              "privacy",
              "accessibility",
              "reliability",
              "compliance",
              "observability",
              "usability",
              "maintainability",
              "constraint",
              "other"
            ]
          },
          "statement": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "must",
              "should",
              "could",
              "wont",
              null
            ],
            "description": "MoSCoW importance within its release. null until the user decides."
          },
          "release": {
            "enum": [
              "current",
              "later",
              null
            ],
            "description": "Which release the item belongs to: current = this PRD's target_release, later = backlog. null until the user decides."
          }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "state",
          "statement",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ASM-\\d{2}$"
          },
          "status": {
            "enum": [
              "active",
              "deprecated"
            ]
          },
          "superseded_by": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/itemId"
              },
              {
                "type": "null"
              }
            ]
          },
          "upstream": {
            "$ref": "common.schema.json#/$defs/links"
          },
          "statement": {
            "type": "string"
          },
          "validation": {
            "type": "string"
          },
          "state": {
            "enum": [
              "open",
              "validated",
              "invalidated"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
