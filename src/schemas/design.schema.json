{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.devforgeai.local/sdd/design.schema.json",
  "title": "design document, DSN (frontmatter plus the boards item block)",
  "type": "object",
  "required": [
    "frontmatter"
  ],
  "properties": {
    "frontmatter": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "status",
        "version",
        "created",
        "updated",
        "owner",
        "authors",
        "upstream",
        "supersedes",
        "superseded_by",
        "blocked_by",
        "canvas",
        "canvas_version",
        "canvas_format",
        "boards_root"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/dsnId"
        },
        "type": {
          "const": "design"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "in-review",
            "approved",
            "superseded",
            "deprecated"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "created": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "updated": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "owner": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generated_by": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tool": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "session": {
              "type": "string"
            }
          }
        },
        "reviewed_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approved_by": {
          "type": "string"
        },
        "approved_on": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "upstream": {
          "$ref": "common.schema.json#/$defs/links"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dsnId"
          }
        },
        "superseded_by": {
          "oneOf": [
            {
              "$ref": "#/$defs/dsnId"
            },
            {
              "type": "null"
            }
          ]
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(BRN|PRD|ARCH|EPIC|SPR|STORY|SPEC|ADR|SKL|POL|TASK|TEST|CTX|AMB|DSN)-\\d{3}(#[A-Z]+-\\d{2,3})?$"
          }
        },
        "canvas": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        },
        "canvas_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "canvas_format": {
          "type": "integer",
          "minimum": 1
        },
        "boards_root": {
          "type": "string",
          "pattern": "^docs/specs/design/DSN-\\d{3}/boards/$"
        }
      },
      "additionalProperties": false
    },
    "boards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "file",
          "title",
          "flow",
          "surface",
          "ideas",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^BRD-\\d{2}$"
          },
          "status": {
            "enum": [
              "active",
              "deprecated"
            ]
          },
          "superseded_by": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^BRD-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "upstream": {
            "$ref": "common.schema.json#/$defs/links"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/\\\\]+$",
            "not": {
              "enum": [
                ".",
                ".."
              ]
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "flow": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "surface": {
            "oneOf": [
              {
                "enum": [
                  "web",
                  "desktop",
                  "mobile",
                  "terminal"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "ideas": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^IDEA-\\d{2}$"
                },
                "uniqueItems": true
              },
              {
                "type": "null"
              }
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "dsnId": {
      "type": "string",
      "pattern": "^DSN-\\d{3}$"
    }
  }
}
