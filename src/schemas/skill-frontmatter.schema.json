{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.devforgeai.local/sdd/skill-frontmatter.schema.json",
  "title": "SKILL.md frontmatter: Agent Skills spec fields plus Claude Code fields; unknown keys rejected",
  "type": "object",
  "required": [
    "name",
    "description"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "not": {
        "pattern": "anthropic|claude"
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^<>]*$"
    },
    "license": {
      "type": "string"
    },
    "compatibility": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "required": [
        "devforgeai-id",
        "devforgeai-version"
      ],
      "properties": {
        "devforgeai-id": {
          "type": "string",
          "pattern": "^SKL-\\d{3}$"
        },
        "devforgeai-version": {
          "type": "string",
          "pattern": "^[1-9]\\d*$"
        }
      }
    },
    "allowed-tools": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "when_to_use": {
      "type": "string",
      "pattern": "^[^<>]*$"
    },
    "argument-hint": {
      "type": "string"
    },
    "arguments": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "disable-model-invocation": {
      "type": "boolean"
    },
    "user-invocable": {
      "type": "boolean"
    },
    "disallowed-tools": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "model": {
      "type": "string"
    },
    "effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "context": {
      "const": "fork"
    },
    "agent": {
      "type": "string"
    },
    "background": {
      "type": "boolean"
    },
    "hooks": {
      "type": "object"
    },
    "paths": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "shell": {
      "enum": [
        "bash",
        "powershell"
      ]
    }
  },
  "additionalProperties": false
}
