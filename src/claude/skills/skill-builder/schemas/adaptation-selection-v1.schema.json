{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal",
    "member_ids",
    "destinations",
    "authorization",
    "permitted_effects"
  ],
  "properties": {
    "schema_version": {
      "const": "adaptation-selection-v1"
    },
    "proposal": {
      "$ref": "adaptive-common.schema.json#/$defs/Ref"
    },
    "member_ids": {
      "type": "array",
      "items": {
        "$ref": "adaptive-common.schema.json#/$defs/Id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "destinations": {
      "type": "array",
      "items": {
        "$ref": "adaptive-common.schema.json#/$defs/Destination"
      }
    },
    "authorization": {
      "$ref": "adaptive-common.schema.json#/$defs/Ref"
    },
    "permitted_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
