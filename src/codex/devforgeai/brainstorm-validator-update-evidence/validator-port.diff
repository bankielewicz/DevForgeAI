+def flow_items(v):
+    """The raw items of a one-line flow list such as ["a", "b"], or None if v isn't one."""
+    if not (v.startswith("[") and v.endswith("]")):
+        return None
+    items, cur, in_quote, escaped = [], "", False, False
+    for ch in v[1:-1]:
+        if in_quote:
+            cur += ch
+            if escaped:
+                escaped = False
+            elif ch == "\\":
+                escaped = True
+            elif ch == '"':
+                in_quote = False
+        elif ch == '"':
+            in_quote = True
+            cur += ch
+        elif ch == ",":
+            items.append(cur.strip())
+            cur = ""
+        else:
+            cur += ch
+    if cur.strip() or items:
+        items.append(cur.strip())
+    return items
 
 
