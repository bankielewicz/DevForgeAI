# Eval results and other scratch output
tmp/
# Where claude plugin eval writes when run without --output-dir
src/claude/DevForgeAI/evals/results/

# Python bytecode
__pycache__/
*.py[cod]

# Windows download metadata, copied in from NTFS
*:Zone.Identifier

# Personal Claude Code settings and DevForgeAI local preferences (ADR-003)
.claude/settings.local.json
.claude/*.local.md

# Placeholder folders the Claude Code sandbox leaves behind
.cc-writes/

# The deployed plugin copy; regenerate it from src/ with the rsync command in CLAUDE.md
.claude/skills/devforgeai/

# Git worktrees, one per story (ADR-001). Unignored, `git add -A` would stage one as an embedded repository
.claude/worktrees/

# Local Codex folder: the deployed Codex plugin copy (.codex/devforgeai/, regenerated from the tracked
# files of src/codex/devforgeai/) and local preferences such as .codex/devforgeai.local.md
.codex/

# Third-party reference material, kept locally only
docs/The-Complete-Guide-to-Building-Skill-for-Claude.pdf
docs/research/

# Raw Codex eval runs (transcripts, protocol dumps, workspaces). Keep the top-level summaries that
# IMPORT-REPORT.md and REPORT.md link to, and each manual check's grade.json.
src/codex/devforgeai/import-evidence/native-evaluation-*/*/
!src/codex/devforgeai/import-evidence/native-evaluation-*/manual/
src/codex/devforgeai/import-evidence/native-evaluation-*/manual/*/*
!src/codex/devforgeai/import-evidence/native-evaluation-*/manual/*/grade.json

# The same for each per-skill evidence folder (architecture-import-evidence/ and later ports): the raw
# run folders hold transcripts and workspaces with local paths. Their summaries, the candidate skill
# and the case definitions stay tracked, as do the files the import reports link to.
src/codex/devforgeai/*-import-evidence/native-evaluation-*/matrix/
src/codex/devforgeai/*-import-evidence/native-evaluation-*/smoke/
src/codex/devforgeai/*-import-evidence/supplemental-*/supplemental/

# Keep review summaries, candidate snapshots, manifests and evaluation cases in Git.
# Raw catalog output and temporary authoring/diagnostic artifacts stay local.
src/codex/devforgeai/*-import-evidence/catalog-preflight/*
!src/codex/devforgeai/*-import-evidence/catalog-preflight/result.json
src/codex/devforgeai/*-import-evidence/authoring-tools/
src/codex/devforgeai/*-import-evidence/whitespace-controls/
src/codex/devforgeai/*-import-evidence/prior-attempts/*.py
src/codex/devforgeai/*-import-evidence/claude-to-codex.patch

# Superseded local receipt for the PRD bundle before publication filtering.
src/codex/devforgeai/prd-import-evidence/pr-publication-checks.json

# This contract campaign publishes source and only four evidence files, as requested.
# Preserve the full evidence folder locally; do not stage raw runs or detailed receipts.
/src/codex/devforgeai/contract-update-evidence/20260929/*
!/src/codex/devforgeai/contract-update-evidence/20260929/REPORT.md
!/src/codex/devforgeai/contract-update-evidence/20260929/evaluation-summary.json
!/src/codex/devforgeai/contract-update-evidence/20260929/failure-categories.json
!/src/codex/devforgeai/contract-update-evidence/20260929/evidence-sha256-manifest.json
/src/codex/devforgeai/CONTRACT-UPDATE-REPORT.md
/src/codex/devforgeai/CONTRACT-UPDATE-DISCREPANCIES.md
