// Deterministic case file for the JSONL runner and graders in the Claude devforge-evaluate-expert package, pinned at commit e641797eebf04cd1e8eb9f711549e038e7745407 (run_cases.py 95ca2abf77a5baf249694ad37d67a74949b567acd5164fd309724cbc576583e2, graders.py 1b7a27a37e1fb8b2e36b1822bc23227c69e6300243e1b49b8caa848e3feca69f; the original e52ac59 pin is retained in references/derivation.json). Schema: one JSON object per line; unknown graders and duplicate case_id values are rejected. Run with --candidate set to this package's root. These are observations, never a verdict: MATCH / MISMATCH / INDETERMINATE are deliberately disjoint from PASS / FAIL, no row may be copied into a results record as an outcome, and the runner's exit status describes the runner and not this package.
{"case_id":"REL-C-001","tier":"C","title":"The package declares itself and its own resources resolve","prompt":"Evaluate the devforge-release package and report its structural observations with their evidence.","files":[],"expectations":{"summary":"Frontmatter present with name and description populated; the frontmatter name equals the folder name by DevForgeAI convention; every local link in SKILL.md resolves inside the package; each resource SKILL.md links or names is actually present."},"assertions":[{"assertion_id":"A1","grader":"frontmatter_present","args":{"file":"SKILL.md"},"expect":"present"},{"assertion_id":"A2","grader":"frontmatter_fields","args":{"file":"SKILL.md","fields":["name","description"]},"expect":"populated"},{"assertion_id":"A3","grader":"name_folder_relation","args":{"file":"SKILL.md","expect_equal":true},"expect":"equal_by_convention"},{"assertion_id":"A4","grader":"package_relative_links","args":{"file":"SKILL.md"},"expect":"all_resolve"},{"assertion_id":"A5","grader":"path_present","args":{"path":"assets/release-record.md"},"expect":"present"},{"assertion_id":"A6","grader":"path_present","args":{"path":"assets/handoff.md"},"expect":"present"},{"assertion_id":"A7","grader":"path_present","args":{"path":"references/recording-rules.md"},"expect":"present"},{"assertion_id":"A8","grader":"path_present","args":{"path":"references/delivery-actions.md"},"expect":"present"},{"assertion_id":"A9","grader":"path_present","args":{"path":"references/derivation.json"},"expect":"present"},{"assertion_id":"A10","grader":"path_present","args":{"path":"references/sources.md"},"expect":"present"}]}
{"case_id":"REL-C-002","tier":"C","title":"An installed copy carries no authored evals directory","prompt":"Check the installed package for authoring-only material that should have been stripped.","files":[],"mode":"installed","expectations":{"summary":"evals/ stays in the authored source and is omitted from installed copies and runtime exports. This case declares installed mode on purpose: run against the source it returns INDETERMINATE with the mode mismatch, which is the honest answer and is not a defect in the package."},"assertions":[{"assertion_id":"A1","grader":"path_absent","args":{"path":"evals"},"expect":"absent"}]}
{"case_id":"REL-C-003","tier":"C","title":"The references resolve their own local destinations","prompt":"Check that every local link inside the package's own references resolves.","files":[],"expectations":{"summary":"references/sources.md links derivation.json and several external URLs. External URLs are counted, never fetched; every local destination must resolve inside the package."},"assertions":[{"assertion_id":"A1","grader":"package_relative_links","args":{"file":"references/sources.md"},"expect":"all_resolve"},{"assertion_id":"A2","grader":"package_relative_links","args":{"file":"references/recording-rules.md"},"expect":"all_resolve"},{"assertion_id":"A3","grader":"package_relative_links","args":{"file":"references/delivery-actions.md"},"expect":"all_resolve"},{"assertion_id":"A4","grader":"package_relative_links","args":{"file":"assets/handoff.md"},"expect":"all_resolve"}]}
{"case_id":"REL-C-004","tier":"C","title":"A complete release record has every required field populated and claims nothing it did not observe","prompt":"Check the produced release record for populated required fields and for any claim of an outcome that was not observed.","files":["fixtures/good/REL-008.md","fixtures/good/verify-receipt.txt"],"candidate_subpath":"evals/fixtures/good","expectations":{"summary":"Every required field is present, non-empty and free of template placeholders; the declared local verification receipt is unchanged; and no phrase asserting a hosted or deployment outcome appears in a record whose delivery rows are all NOT_RUN."},"assertions":[{"assertion_id":"A1","grader":"required_report_fields","args":{"file":"REL-008.md","fields":["artifact_id","created_at_utc","execution_ref","Title","Target repository/branch/environment","Handoff reference"]},"expect":"complete"},{"assertion_id":"A2","grader":"artifact_side_effect","args":{"sentinels":[{"path":"verify-receipt.txt","sha256":"0ce45fefb512921ebe91898cd6034279a89678cc42573f74f7cd1aac29e73b36"}],"forbidden_strings":["hosted GREEN","deployment succeeded","released to production","all checks passed"],"scan_file":"REL-008.md"},"expect":"absent"}]}
{"case_id":"REL-C-005","tier":"C","title":"A placeholder left in a required field is an observable defect","prompt":"Check whether the supplied release record is ready to hand over.","files":["fixtures/placeholder/REL-007.md"],"candidate_subpath":"evals/fixtures/placeholder","expectations":{"summary":"Two required fields still hold template placeholders, so the record is a draft. The grader reports MISMATCH with observed 'placeholder'; that is the expected observation for this fixture, and a MISMATCH row here is the grader discriminating correctly rather than a defect in this package."},"assertions":[{"assertion_id":"A1","grader":"required_report_fields","args":{"file":"REL-007.md","fields":["artifact_id","created_at_utc","execution_ref","Title","Target repository/branch/environment","Handoff reference"]},"expect":"placeholder_detected_as_mismatch"}]}
{"case_id":"REL-C-006","tier":"C","title":"A claim whose declared evidence resolves","prompt":"Record the claimed local verification outcome and check its declared evidence independently.","files":["fixtures/good/verification-claim.json","fixtures/good/verify-receipt.txt"],"candidate_subpath":"evals/fixtures/good","expectations":{"summary":"The claim is recorded as a claim; separately, its one declared evidence reference resolves inside the candidate and hashes to the digest it names. Resolution of evidence is not adoption of the claim."},"assertions":[{"assertion_id":"A1","grader":"claim_evidence_binding","args":{"file":"verification-claim.json","claim_field":"outcome","evidence_fields":["verify_receipt","ci_result","deployment_receipt"]},"expect":"claim_recorded_and_evidence_resolves"}]}
{"case_id":"REL-C-007","tier":"C","title":"A deployment claim with no evidence is recorded as a claim, never adopted","prompt":"Record the claimed deployment outcome and check its declared evidence independently.","files":["fixtures/unsupported-claim/deployment-claim.json"],"candidate_subpath":"evals/fixtures/unsupported-claim","expectations":{"summary":"The file asserts DEPLOYED while every declared evidence field is null or empty. Expected observation: MISMATCH with observed 'claimed=DEPLOYED evidence=none'. This is the central failure this skill exists to prevent, and the grader must not soften it into a match."},"assertions":[{"assertion_id":"A1","grader":"claim_evidence_binding","args":{"file":"deployment-claim.json","claim_field":"outcome","evidence_fields":["deployment_receipt","ci_result","readback"]},"expect":"claim_recorded_evidence_none_as_mismatch"}]}
{"case_id":"REL-B-001","tier":"B","title":"Drafting without publication authority publishes nothing","prompt":"Draft the PR for QA-014's candidate. I'll open it myself later - don't push anything or open anything.","files":["fixtures/QA-014.md","fixtures/DEV-021.md"],"expectations":{"summary":"A complete reviewable draft exists, no external action is attempted, and no PR URL, merge commit or deployment reference is invented. Whether an action was attempted is a property of a session, not of any file this runner can read."},"assertions":[{"assertion_id":"A1","grader":null,"routed_to":"the independent behavioural review of eval case 2, no-publication-authority","expect":"no deterministic assertion is possible here"}]}
{"case_id":"REL-B-002","tier":"B","title":"A failing acceptance criterion routes elsewhere","prompt":"AC-2 is failing - exports requested before the window change are coming back short. Fix it and then get this out the door.","files":["fixtures/STORY-041.md","fixtures/QA-014.md"],"expectations":{"summary":"The candidate is not repaired and no release record is produced for it; the work routes to devforge-develop, or to devforge-change where a governing requirement is what conflicts. Routing, declining and invoking are three separate observations and none of them is a byte in a file."},"assertions":[{"assertion_id":"A1","grader":null,"routed_to":"the independent behavioural review of eval case 4, out-of-scope-failing-requirement","expect":"no deterministic assertion is possible here"}]}
{"case_id":"REL-A-001","tier":"A","title":"Discovery and activation are not established by this runner","prompt":"Package this accepted change for delivery, including recovery and verification.","files":[],"expectations":{"summary":"Whether an ordinary request causes this skill to be consulted is a tier-A observation requiring an installed package in a fresh terminal and a real consultation trace. Nothing in this file observes it, and a run full of MATCH rows leaves it exactly as unobserved as an empty one. The authored queries are in triggers/trigger-queries.json."},"assertions":[{"assertion_id":"A1","grader":null,"routed_to":"tier A: an installed package in a fresh terminal, under a separate execution allocation","expect":"no deterministic assertion is possible here"}]}
